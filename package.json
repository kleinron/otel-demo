{
  "name": "otel-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Observability experiment: an instrumented electronics store.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "loadgen",
    "infra/aws"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "teardown": "tsx scripts/teardown.ts",
    "teardown:rehearsal": "tsx scripts/teardown-rehearsal.ts",
    "deploy:check": "tsx scripts/deploy-check.ts",
    "grafana:url": "tsx scripts/grafana-url.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:aws": "tsx scripts/seed-aws.ts",
    "loadgen:start": "tsx scripts/loadgen-scale.ts 1",
    "loadgen:stop": "tsx scripts/loadgen-scale.ts 0",
    "image:build": "bash scripts/build-service-image.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "tsx": "^4.20.6",
    "vitest": "^5.0.3"
  }
}
