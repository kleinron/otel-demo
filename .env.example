# Copy to .env and fill the tokens only on your machine. .env is gitignored.
# This repository is public. Do not commit real Logz.io tokens.

# Debug-only collector. Switch to the Logz.io file after the tokens below are set:
# OTEL_COLLECTOR_CONFIG=/etc/otelcol-contrib/collector-logzio.yaml
OTEL_COLLECTOR_CONFIG=/etc/otelcol-contrib/config.yaml

# Settings → Manage tokens → Data shipping tokens.
LOGZIO_TRACING_TOKEN=
LOGZIO_LOGS_TOKEN=
LOGZIO_METRICS_TOKEN=

# Account region code from the same settings page (us, eu, au, ca, uk, nl, wa).
# Traces and logs: the bare OTLP host on port 443. The collector appends
# /v1/traces and /v1/logs. Do not add :4318. That port does not answer.
# Metrics: https://listener-<region>.logz.io:8053 (US has no region suffix).
#   us  https://otlp-listener.logz.io      https://listener.logz.io:8053
#   eu  https://otlp-listener-eu.logz.io   https://listener-eu.logz.io:8053
#   au  https://otlp-listener-au.logz.io   https://listener-au.logz.io:8053
#   ca  https://otlp-listener-ca.logz.io   https://listener-ca.logz.io:8053
#   uk  https://otlp-listener-uk.logz.io   https://listener-uk.logz.io:8053
#   nl  https://otlp-listener-nl.logz.io   https://listener-nl.logz.io:8053
#   wa  https://otlp-listener-wa.logz.io   https://listener-wa.logz.io:8053
LOGZIO_REGION=us
LOGZIO_TRACES_ENDPOINT=https://otlp-listener.logz.io
LOGZIO_LOGS_ENDPOINT=https://otlp-listener.logz.io
LOGZIO_METRICS_ENDPOINT=https://listener.logz.io:8053

# Cart activities per minute for the local load generator. Other streams scale
# with the checked-in schedule. Unset on the AWS and GCP tasks.
LOADGEN_CARTS_PER_MINUTE=1
