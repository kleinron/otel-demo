# Copy to .env and fill the tokens only on your machine. .env is gitignored.
# This repository is public. Do not commit real Logz.io tokens.

# Debug-only collector. Switch to the Logz.io file after the tokens below are set:
# OTEL_COLLECTOR_CONFIG=/etc/otelcol-contrib/collector-logzio.yaml
OTEL_COLLECTOR_CONFIG=/etc/otelcol-contrib/config.yaml

# Settings → Manage tokens → Data shipping tokens.
LOGZIO_TRACING_TOKEN=
LOGZIO_LOGS_TOKEN=
LOGZIO_METRICS_TOKEN=

# Account region code from the same settings page (us, eu, au, ca, uk, nl, wa).
# The listener hosts have to match that region. These defaults are the US listeners.
LOGZIO_REGION=us
LOGZIO_TRACES_ENDPOINT=https://otlp-listener.logz.io:4318
LOGZIO_LOGS_ENDPOINT=https://otlp-listener.logz.io:4318
LOGZIO_METRICS_ENDPOINT=https://listener.logz.io:8053

# Cart activities per minute for the local load generator. Other streams scale
# with the checked-in schedule. Unset on the AWS and GCP tasks.
LOADGEN_CARTS_PER_MINUTE=1
