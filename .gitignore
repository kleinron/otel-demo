# Local environment and secrets. .env.example is the committed placeholder.
.env*
!.env.example

# Experiment outputs (kept off the public remote)
results/
raw/

# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# AWS CDK and local cloud credentials
cdk.out/
.aws/
*.pem

# Terraform local state and filled variable files. The example tfvars is safe to commit.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
*-sa-key.json
gcp-key.json
